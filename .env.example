# LLM Configuration - Primary Provider (OpenRouter)
# Use generic names OR provider-specific names (script checks both)
API_KEY_PRIMARY=your_api_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
LLM_ENDPOINT_PRIMARY=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL_PRIMARY=auto
OPENROUTER_MODEL=auto

# LLM Configuration - Fallback Provider
# Configure if needed for fallback LLM
API_KEY_FALLBACK=your_fallback_api_key_here
LLM_ENDPOINT_FALLBACK=https://api.anthropic.com/v1/messages
LLM_MODEL_FALLBACK=claude-opus

# Rendering Configuration
# RENDER_CONCURRENCY: Number of parallel render workers (default: 80% of available CPU cores)
# Higher = faster but more resource-intensive
RENDER_CONCURRENCY=

# Video Output
# MP4 files will be saved to: out/videos/
# Temporary cache: .cache/script.json
